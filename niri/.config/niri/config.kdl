// --- AUTOSTART ---
spawn-at-startup "foot" "--server"

prefer-no-csd

// --- INPUT ---
input {
    keyboard {
        // layout lives in keyd (/etc/keyd/default.conf); xkb is plain US
        xkb {
            layout "us"
            variant "altgr-intl"
        }
        repeat-rate 100
        repeat-delay 400
    }

    touchpad {
        tap
        dwt
    }
}

hotkey-overlay {
    skip-at-startup
}

// --- APPEARANCE ---
animations {
    on
}

layout {
    background-color "#acb0be"

    focus-ring {
        width 4
        active-color "#1e66f5"
    }
    border {
        off
    }
    shadow {
        off
    }
}

// --- WINDOW RULES ---
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
    draw-border-with-background false
}

window-rule {
    match app-id="chromium"
    open-maximized true
}

// --- OVERVIEW ---
overview {
    backdrop-color "#acb0be"
    workspace-shadow {
        off
    }
}

// --- OUTPUTS ---
output "eDP-1" {
    position x=0 y=0
}

output "HDMI-A-1" {
    focus-at-startup
}


// --- BINDS ---
binds {
    // Volume Controls
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

    // Application Launchers
    Mod+A { spawn "footclient"; }
    Mod+D { spawn "fuzzel"; }
    Mod+U { spawn "sys-menu.fish"; }

    // Interactive screenshot (select a region)
    Print { screenshot; }

    // Screenshot the currently focused window
    Mod+Shift+Print { screenshot-window; }

    // Screenshot the entire screen
    Mod+Print { screenshot-screen; }

    // Window Management
    Mod+Shift+Comma { close-window; }   // Mod + Space + k  (sends <)

    // quit
    Mod+Shift+E { quit; }

    // Focus Navigation
    Mod+S { focus-column-left; }
    Mod+R { focus-column-right; }

    // Moving Windows  (hold nav layer: s=Escape, r=Delete, m/f=Up/Down)
    Mod+Escape { move-column-left; }
    Mod+Delete { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }

    // View Modes
    Mod+I { maximize-column; }
    Mod+Z { toggle-window-floating; }
    Mod+J { maximize-window-to-edges; }

    // Workspaces
    Mod+T { focus-workspace-up; }
    Mod+N { focus-workspace-down; }
    Mod+G { focus-workspace 1; }
    Mod+M { focus-workspace 2; }
    Mod+F { focus-workspace 3; }
    Mod+W { focus-workspace 4; }
    Mod+End { move-workspace-to-monitor-right; }   // nav + q
    Mod+Home { move-workspace-to-monitor-left; }   // nav + c
    Mod+Q { focus-monitor-right; }
    Mod+C { focus-monitor-left; }
    Mod+Shift+T { move-workspace-up; }
    Mod+Shift+N { move-workspace-down; }

    // Move Window to Workspaces  (hold nav layer: t=BackSpace, n=Tab, g/m/f/w=arrows)
    Mod+BackSpace { move-column-to-workspace-up; }
    Mod+Tab { move-column-to-workspace-down; }
    Mod+Left { move-column-to-workspace 1; }
    Mod+Up { move-column-to-workspace 2; }
    Mod+Down { move-column-to-workspace 3; }
    Mod+Right { move-column-to-workspace 4; }
    Mod+Shift+Minus { move-column-to-workspace 1; }
    Mod+Shift+Apostrophe { move-column-to-workspace 2; }
    Mod+Shift+4 { move-column-to-workspace 3; }
    Mod+Shift+Slash { move-column-to-workspace 4; }

    // Output Navigation  (hold nav layer: l=F23, p=F24)
    Mod+F23 { focus-monitor-up; }
    Mod+F24 { focus-monitor-down; }

    // Resizing
    Mod+KP_Subtract { set-column-width "-30"; }
    Mod+Shift+Equal { set-column-width "+30"; }
    Mod+Equal { set-column-width "50%"; }

    // Overview
    Mod+Space { toggle-overview; }
}

